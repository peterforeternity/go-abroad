{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Standalone staging config. Deploy with --config only; do not pass an
  // environment flag that could select an unrelated production environment.
  "name": "study-abroad-staging",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],

  // workers.dev is enabled only for the Access-protected staging entry.
  // Keep preview URLs disabled and verify Access before testing the endpoint.
  // Replace only the two resource IDs after creation.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "study-abroad-staging-db",
      "database_id": "<REPLACE_WITH_STAGING_D1_DATABASE_ID>",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "<REPLACE_WITH_STAGING_KV_NAMESPACE_ID>"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "vars": {
    "APP_ENV": "staging",
    "NEXT_PUBLIC_SITE_URL": "<REPLACE_WITH_ACCESS_PROTECTED_STAGING_ORIGIN>",
    "ALLOWED_ORIGINS": "<REPLACE_WITH_ACCESS_PROTECTED_STAGING_ORIGIN>",
    "ALLOW_DEMO_DATA": "false",
    "DATA_PROVIDER_MODE": "public-apis",
    "CACHE_PROVIDER": "kv",
    "KV_NAMESPACE_BINDING": "KV",
    "RATE_LIMIT_PROVIDER": "kv",
    "AUTH_PROVIDER_MODE": "d1",
    "EMAIL_PROVIDER_MODE": "resend",
    "SESSION_TTL_SECONDS": "1209600",
    "CACHE_TTL_SECONDS": "300",
    "RATE_LIMIT_REQUESTS": "100",
    "RATE_LIMIT_WINDOW_SECONDS": "60"
  }
}
