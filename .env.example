# Copy to .env.local for local development. Never commit real values.
# Allowed values: development | staging | production
APP_ENV=development

# Local development may use the explicit demo provider. Staging/production must use http.
DATA_PROVIDER_MODE=demo
DATA_PROVIDER_BASE_URL=
DATA_PROVIDER_API_KEY=
DATA_PROVIDER_ENDPOINT=/study-abroad
DATA_PROVIDER_TIMEOUT_MS=5000
DATA_PROVIDER_RETRY_COUNT=2

# The site URL is public configuration, not a secret.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# development uses memory; staging/production should use cache-api or kv.
CACHE_PROVIDER=memory
CACHE_TTL_SECONDS=300
KV_NAMESPACE_BINDING=

# development uses memory; staging/production must configure an external edge limiter.
RATE_LIMIT_PROVIDER=memory
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# External auth/email configuration. Keep values empty until the provider is selected.
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
SESSION_SECRET=
EMAIL_PROVIDER_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=

# Monitoring configuration. The DSN is not a credential, the auth token is.
MONITORING_DSN=
MONITORING_AUTH_TOKEN=

# Bot protection (optional but recommended for public auth endpoints).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Used only for an authenticated sync/admin callback, never exposed to the browser.
DATA_SYNC_WEBHOOK_SECRET=
