# Copy to .env.local for local development. Never commit real values.
# Allowed values: development | staging | production
APP_ENV=development

# Allowed: demo | http | public-apis.
# demo is development-only. http uses one contracted upstream and requires its URL/API key.
# public-apis aggregates OpenAlex, GOV.UK, and Federal Register without business secrets.
DATA_PROVIDER_MODE=demo
DATA_PROVIDER_BASE_URL=
DATA_PROVIDER_API_KEY=
DATA_PROVIDER_ENDPOINT=/study-abroad
DATA_PROVIDER_TIMEOUT_MS=5000
DATA_PROVIDER_RETRY_COUNT=2

# The site URL is public configuration, not a secret.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Allowed: memory | cache-api | kv. memory is development-only; staging uses kv.
CACHE_PROVIDER=memory
CACHE_TTL_SECONDS=300
KV_NAMESPACE_BINDING=

# Allowed: memory | kv. memory is development-only; staging/production must use kv.
RATE_LIMIT_PROVIDER=memory
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Native D1 auth + Resend email. Keep Secret values empty in committed files.
AUTH_PROVIDER_MODE=d1
SESSION_SECRET=
SESSION_TTL_SECONDS=1209600
EMAIL_PROVIDER_MODE=resend
EMAIL_PROVIDER_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=

# Monitoring configuration. The DSN is not a credential, the auth token is.
MONITORING_DSN=
MONITORING_AUTH_TOKEN=
SENTRY_AUTH_TOKEN=
ALERT_WEBHOOK_URL=

# Bot protection (optional but recommended for public auth endpoints).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Used only for an authenticated sync/admin callback, never exposed to the browser.
DATA_SYNC_WEBHOOK_SECRET=
